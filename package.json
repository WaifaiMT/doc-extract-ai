{
  "name": "doc-extract-ai",
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "eval": "tsx eval/run-eval.ts"
